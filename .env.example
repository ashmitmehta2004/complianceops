# Copy to backend/.env and fill in values. Never commit .env.

# Which provider the agent uses: "gemini" or "anthropic" (default: anthropic)
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash. Must support function calling; check
# https://ai.google.dev/gemini-api/docs/models if it is unavailable to your project.
GEMINI_MODEL=

# Anthropic (only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# SQLite database. Relative paths resolve against the directory you start the process from
# (run commands from backend/). Defaults to sqlite:///./complianceops.db if unset.
DATABASE_URL=sqlite:///./complianceops.db

# Identity recorded on approval decisions in the local demo. NOT authentication.
DEMO_ACTOR=demo.compliance.officer
